{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garmgoon-domain",
  "compatibility_date": "2026-08-26",
  "routes": [
    {
      "pattern": "garmgoon.com",
      "custom_domain": true
    },
    {
      "pattern": "www.garmgoon.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "single-page-application"
  }
}
